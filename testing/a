SELECT
    c.id AS customer_id,
    c.pppoe_username,
    c.created_at AS old_created_at,
    i.first_invoice_date
FROM customers c
JOIN (
    SELECT
        customer_id,
        MIN(due_date) AS first_invoice_date
    FROM invoices
    GROUP BY customer_id
) i ON i.customer_id = c.id
WHERE i.first_invoice_date BETWEEN '2026-05-01' AND '2026-06-30';